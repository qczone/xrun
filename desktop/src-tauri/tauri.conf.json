{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xrun",
  "version": "0.0.1-beta.1",
  "identifier": "dev.qczone.xrun",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main", "title": "xrun", "width": 720, "height": 740,
      "minWidth": 560, "minHeight": 620, "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run programs on your paired devices",
    "license": "MIT",
    "externalBin": ["binaries/xrun"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "files": { "Library/LaunchAgents/dev.qczone.xrun.daemon.plist": "resources/dev.qczone.xrun.daemon.plist" }
    },
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "resources/installer.nsh" } }
  }
}
